<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:j2seproject3="http://www.netbeans.org/ns/j2se-project/3" name="EditorWordArt-impl" default="default" basedir="..">
    <target name="-pre-init"/>
    <target name="-init-private"/>
    <target name="-init-user"/>
    <target name="-init-project"/>
    <target name="-init-macrodef-property"/>
    <target name="-init-macrodef-javac"/>
    <target name="-init-macrodef-java"/>
    <target name="-init-macrodef-copylibs"/>
    <target name="-init-presetdef-jar"/>
    <target name="-init-ap-cmdline-properties"/>
    <target name="-init-source-module-properties"/>
    <target name="-init-test-module-properties"/>
    <target name="-init-macrodef-modulename"/>
    <target name="-init-source-module-properties-without-module"/>
    <target name="-init-test-module-properties-without-module"/>
    <target name="-init-check"/>
    <target name="-init-macrodef-junit"/>
    <target name="-init-macrodef-junit-impl"/>
    <target name="-init-macrodef-junit-init"/>
    <target name="-init-macrodef-test-impl"/>
    <target name="-init-macrodef-testng"/>
    <target name="-init-macrodef-testng-impl"/>
    <target name="-init-macrodef-testng-init"/>
    <target name="-init-macrodef-testng-debug"/>
    <target name="-init-macrodef-test-debug"/>
    <target name="-init-debug-args"/>
    <target name="-init-macrodef-nbjpda"/>
    <target name="-init-macrodef-debug"/>
    <target name="-init-macrodef-java-with-module"/>
    <target name="-init-macrodef-java-without-module"/>
    <target name="init" depends="-pre-init,-init-private,-init-user,-init-project">
        <property file="nbproject/project.properties"/>
        <mkdir dir="${build.dir}"/>
    </target>
    <target name="-pre-compile"/>
    <target name="compile" depends="init,-pre-compile">
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" source="${javac.source}" target="${javac.target}" encoding="${source.encoding}"/>
    </target>
    <target name="-post-compile"/>
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>
    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    <target name="default" depends="jar"/>
</project>
